# HYDROVISION AI Environment Configuration

# Application
APP_NAME="HydroVision AI"
APP_ENV="development"
DEBUG=True
SECRET_KEY="hydrovision-ai-super-secret-government-key-change-in-production"
API_V1_STR="/api/v1"

# Database (PostgreSQL with PostGIS support / SQLite local fallback)
DATABASE_URL="sqlite:///./hydrovision.db"
# DATABASE_URL="postgresql://hydrovision:hydrovision_pass@localhost:5432/hydrovision_db"

# JWT Authentication
JWT_SECRET="hydrovision-jwt-secret-key-32-bytes-minimum-security"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Object Storage (MinIO / S3)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="hydrovision-media"
MINIO_SECURE=False

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"

# AI Models Configuration
YOLO_MODEL_PATH="./models/yolo11_dam_defects.pt"
XGBOOST_MODEL_PATH="./models/xgboost_deterioration.json"
